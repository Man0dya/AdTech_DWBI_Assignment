      DTS:ObjectName="Expire Old User Records"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E84821E2-DD63-4871-99BB-06BCA9B88FBA}"
          SQLTask:SqlStatementSource="UPDATE d&#xA;SET&#xA;    d.ValidTo = GETDATE(),&#xA;    d.IsCurrent = 0&#xA;FROM dbo.DimUser d&#xA;WHERE d.IsCurrent = 1&#xA;AND EXISTS (&#xA;    SELECT 1&#xA;    FROM AdTech_Staging.dbo.StgChangedUsers s&#xA;    WHERE s.user_id = d.UserNK&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
