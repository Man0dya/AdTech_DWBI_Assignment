      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{148C49E7-BA57-40EA-8A56-C92BB307D354}"
          SQLTask:SqlStatementSource="UPDATE f&#xA;SET&#xA;    f.accm_txn_complete_time = s.accm_txn_complete_time,&#xA;    f.txn_process_time_hours =&#xA;        DATEDIFF(MINUTE, f.accm_txn_create_time, s.accm_txn_complete_time) / 60.0&#xA;FROM dbo.FactAdEvent f&#xA;INNER JOIN AdTech_Staging.dbo.StgCompletionUpdates s&#xA;    ON f.EventTransactionID = s.txn_id;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
